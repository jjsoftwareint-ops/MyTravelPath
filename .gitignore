.claude/skills/

# The user's own photo originals (RAW, 1.4 GB+), converted with the raw-to-jpeg skill; never committed.
# assets/ is Vite's publicDir, so anything committed here would be published with the site.
assets/myPhotos/
raw/

# Social-post photos (Threads needs a public URL, so a chain's photos are pushed with `git add -f`,
# posted, then removed from the remote again with `git rm --cached`; the local copies stay).
assets/sns/
