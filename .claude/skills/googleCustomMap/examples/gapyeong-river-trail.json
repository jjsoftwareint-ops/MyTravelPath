   "pins": [
    {
     "lat": 37.814518,
     "lon": 127.510731,
     "name": "Start: Gapyeong Station (가평역)",
     "icon": "subway",
     "naver_id": "13590931",
     "image": "https://search.pstatic.net/common/?autoRotate=true&quality=95&type=f&size=256x256&src=https%3A%2F%2Fsimg.pstatic.net%2Fstatic.map%2Fv2%2Fmap%2Fstaticmap.bin%3Fcaller%3Dpubtrans_search%26scale%3D1%26w%3D256%26h%3D256%26center%3D127.5107313%2C37.8145184%26level%3D16%26format%3Djpg%26markers%3Dtype%3Ad%7Csize%3Amid%7CviewSizeRatio%3A0.7%7Cpos%3A127.5107313%2037.8145184%7Ccolor%3ADefault",
     "desc": "Gyeongchun line. ITX-Cheongchun from Yongsan takes under an hour (first train 06:15 in the video); the ordinary subway about 1 h 40. Leave the station and turn left; at the big crossroads turn left again and go straight up; pass under the Gyeongchun line bridge, cross at the Jara Island sign and keep left; at the small five-way junction take the 2 o'clock arm onto the paved bike path, which leads to Gyeonggang Bridge. Convenience stores along the way; buy drinks here, there is little on the trail. From the video \"경기도와 강원을 이어주는 17km 강변 트레킹\" (Oct 2023)."
    },
    {
     "lat": 37.826689,
     "lon": 127.524043,
     "name": "Gyeonggang Bridge, Gyeonggi–Gangwon border (경강교)",
     "icon": "bridge",
     "naver_id": "19146842",
     "image": "none",
     "desc": "Jara Island is on the right as you cross. Gyeonggi ends here; the far end of the bridge is Chuncheon, Gangwon. Follow the bike lane down under the bridge: that is the entrance of the Bukhan River riverside path (북한강 강변길), and the trail turns right along the river."
    },
    {
     "lat": 37.84317,
     "lon": 127.550019,
     "name": "Old Gyeongchun-line railway bridge, now the rail bike (강촌레일파크 경강레일바이크)",
     "icon": "camera",
     "naver_id": "30840801",
     "image": "https://search.pstatic.net/common/?autoRotate=true&quality=100&type=f640_380&src=https%3A%2F%2Fldb-phinf.pstatic.net%2F20180912_285%2F1536713978172hIcRz_JPEG%2F5LsAsWsxZ1sSNuXYak7cXVrQ.jpg",
     "desc": "Seobaek-gil 57, Namsan-myeon, Chuncheon. The old iron railway bridge is the first thing you meet on the riverside path; today only the Gangchon Rail Park bikes cross it. An unpaved path on the left runs closer to the water: the best stretch of the walk in the video."
    },
    {
     "lat": 37.8456,
     "lon": 127.551813,
     "name": "Chunseong Bridge (춘성대교)",
     "icon": "bridge",
     "naver_id": "15648415",
     "image": "none",
     "desc": "The red bridge between Namsan-myeon and Seo-myeon of Chuncheon. The riverside deck path (북한강 데크길) starts after it, with the pointed peak of Samaksan ahead. Few benches on this trail: bring a small mat."
    },
    {
     "lat": 37.830883,
     "lon": 127.589108,
     "name": "Baegyang-ri Station, alternative start (백양리역)",
     "icon": "subway",
     "naver_id": "13590937",
     "image": "https://search.pstatic.net/common/?autoRotate=true&quality=95&type=f&size=256x256&src=https%3A%2F%2Fsimg.pstatic.net%2Fstatic.map%2Fv2%2Fmap%2Fstaticmap.bin%3Fcaller%3Dpubtrans_search%26scale%3D1%26w%3D256%26h%3D256%26center%3D127.5891079%2C37.8308826%26level%3D16%26format%3Djpg%26markers%3Dtype%3Ad%7Csize%3Amid%7CviewSizeRatio%3A0.7%7Cpos%3A127.5891079%2037.8308826%7Ccolor%3ADefault",
     "desc": "Bukhangangbyeon-gil 690, Namsan-myeon. Gyeongchun line and ITX stop. Short on time? Start here: about 6 km and 2 hours to Gangchon Station. The field of silver grass (억새) in front of the station is the autumn highlight of the walk. Toilets at the station; from the riverside path go up through the car park and the stairs. Further along the road a signpost points to the old station: there is no crossing, take care."
    },
    {
     "lat": 37.826654,
     "lon": 127.612699,
     "name": "Old Baegyang-ri Station, closed (백양리역 폐역)",
     "icon": "historic",
     "naver_id": "20676916",
     "image": "https://simg.pstatic.net/static.map/v2/map/staticmap.bin?caller=pubtrans_search&lang=ko&scale=2&w=200&h=200&center=127.6126992,37.8266538&level=15&format=png&maptype=basic&markers=type:d|size:mid|viewSizeRatio:0.7|pos:127.6126992 37.8266538|color:0x029DFF&logo=false",
     "desc": "The abandoned station of the old Gyeongchun line, a short climb up the hill. The ticket hall and station office are preserved with the old fares and books; rest area. From here the old track, turned into a 2 km walking path, leads to the old Gangchon Station through the Gangchon Piam tunnel (강촌 피암터널), full of graffiti. Autumn colour is good on this stretch."
    },
    {
     "lat": 37.815878,
     "lon": 127.632518,
     "name": "Old Gangchon Station and Gangchon Rail Park (옛 강촌역 · 강촌레일파크 강촌역)",
     "icon": "historic",
     "naver_id": "30836923",
     "image": "https://search.pstatic.net/common/?autoRotate=true&quality=100&type=f640_380&src=https%3A%2F%2Fpup-review-phinf.pstatic.net%2FMjAyNjEwMjdfMTAx%2FMDAxNzkzMDY1OTM3NDQ0.ZpfW10KrnGKitu_mKUEsQHSRKz8TziMa3-feEGbMi_cg.r2XZOk5UyChpJiSKlgzAiH7XhhEtpXRjmT7DAosHQrcg.JPEG%2F20261027_095722.jpg",
     "desc": "Gangchon-ro 34, Namsan-myeon. The old station building is now a craft workshop; in front stand the duck statue (또오리상) and the rail bike platform, and the old railway bridge beyond is rail-bike only. The restaurant street (dakgalbi) is just below; the big convenience store in the middle of it has a lane down to the river."
    },
    {
     "lat": 37.805263,
     "lon": 127.637215,
     "name": "Gangchon Umi charcoal dakgalbi (강촌우미숯불닭갈비)",
     "icon": "restaurant",
     "naver_id": "31418439",
     "image": "https://search.pstatic.net/common/?autoRotate=true&quality=100&type=f640_380&src=https%3A%2F%2Fldb-phinf.pstatic.net%2F20210903_216%2F1630634855336HuEkX_JPEG%2FOXUwtQWfOt73WfssFPRir3AN.jpg",
     "desc": "Gangchon-ro 159, next to Gangchon Station. Charcoal-grilled dakgalbi (spicy chicken), the best-reviewed in Gangchon (1,260+ Naver reviews); single portions are cooked separately. Hours on Naver (checked 2026-10-30): Mon–Thu, Sun 11:00–20:30, Fri–Sat 11:00–21:00, last order an hour before. Still in business on Naver as of 2026-10-30."
    },
    {
     "lat": 37.808501,
     "lon": 127.63567,
     "name": "Yoonskko octopus and dakgalbi (윤스꼬 맥반석숯불문어와닭갈비)",
     "icon": "restaurant",
     "naver_id": "36957242",
     "image": "https://search.pstatic.net/common/?autoRotate=true&quality=100&type=f640_380&src=https%3A%2F%2Fldb-phinf.pstatic.net%2F20240509_171%2F1715228787429uxwiU_JPEG%2F%25C5%25A9%25B1%25E2%25BA%25AF%25C8%25AFIMG_0169.JPG",
     "desc": "Gangchon Gugok-gil 9, between the restaurant street and the station. Dakgalbi and octopus grilled on elvan stone over charcoal; 1,300+ Naver reviews. Hours on Naver (checked 2026-10-30): Mon–Fri 10:30–21:00, Sat–Sun 10:00–22:00, last order an hour before. Still in business on Naver as of 2026-10-30."
    },
    {
     "lat": 37.813323,
     "lon": 127.635399,
     "name": "Gangchon suspension bridge over the stream (강촌 출렁다리, Naver: 등선교)",
     "icon": "bridge",
     "naver_id": "37053726",
     "image": "none",
     "desc": "Where the Gangchon stream meets the river, below the restaurant street: stepping stones and a swaying footbridge with a good view. The riverside promenade is a small detour but far prettier than the road. Then follow the embankment under Gangchon Bridge (강촌대교), cross the small wooden bridge and keep straight to the station."
    },
